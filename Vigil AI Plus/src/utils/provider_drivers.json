{
  "aliexpress": {
    "base_url": "https://api-sg.aliexpress.com/sync",
    "method": "GET",
    "auth_type": "signature",
    "search_param": "keywords",
    "add_timestamp": true,
    "signature_algorithm": "sha256",
    "signature_format": "concat",
    "signature_in": "params",
    "signature_param": "sign",
    "response_path": "aliexpress_affiliate_product_query_response.resp_result.result.products.product",
    "field_mapping": {
      "product_id": "product_id",
      "name": "product_title",
      "video_url": "product_video_url",
      "price": "target_sale_price",
      "currency": "target_sale_price_currency",
      "image_url": [
          "product_main_image_url",
          "product_small_image_urls.string.0"
      ],
      "product_url": "product_detail_url",
      "affiliate_link": "promotion_link",
      "sale_price_usd": "target_sale_price",
      "currency_usd": "target_sale_price_currency",
      "sale_price_cny": "app_sale_price",
      "currency_cny": "app_sale_price_currency",
      "original_price_usd": "target_original_price",
      "original_price_cny": "original_price"
    },
    
    "static_params": {
      "method": "aliexpress.affiliate.product.query",
      "format": "json",
      "sign_method": "sha256",
      "page_size": "15",
      "app_key": "{{api_key}}"
    },
    "required_fields": ["api_key", "api_secret", "associate_tag"],
    "field_labels": {
      "api_key": "App Key (Client ID)",
      "api_secret": "App Secret (Client Secret)",
      "associate_tag": "Tracking ID"
    }
  },
  "amazon": {
    "base_url": "https://webservices.amazon.com/paapi5/searchitems",
    "method": "POST",
    "auth_type": "signature",
    "search_param": "Keywords",
    "add_timestamp": true,
    "signature_in": "header",
    "response_path": "SearchResult.Items",
    "field_mapping": {
      "product_id": "ASIN",
      "name": "ItemInfo.Title.DisplayValue",
      "price": "Offers.Listings.0.Price.Amount",
      "currency": "Offers.Listings.0.Price.Currency",
      "image_url": "Images.Primary.Large.URL",
      "product_url": "DetailPageURL",
      "original_price": "Offers.Listings.0.Price.Amount"
    },
    "body_data": {
      "PartnerTag": "{{associate_tag}}",
      "PartnerType": "Associates",
      "SearchIndex": "All",
      "ItemCount": 5
    },
    "required_fields": ["api_key", "api_secret", "associate_tag"],
    "field_labels": {
      "api_key": "Access Key",
      "api_secret": "Secret Key",
      "associate_tag": "Partner Tag (Associate Tag)"
    }
  },
  "flipkart": {
    "base_url": "https://affiliate-api.flipkart.net/affiliate/search/json",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Fk-Affiliate-Id",
    "auth_secret_header": "Fk-Affiliate-Token",
    "search_param": "query",
    "response_path": "productInfoList",
    "field_mapping": {
      "product_id": "productBaseInfoV1.productId",
      "name": "productBaseInfoV1.title",
      "price": "productBaseInfoV1.flipkartSellingPrice.amount",
      "currency": "productBaseInfoV1.flipkartSellingPrice.currency",
      "image_url": "productBaseInfoV1.imageUrls.200x200",
      "product_url": "productBaseInfoV1.productUrl",
      "original_price": "productBaseInfoV1.flipkartSellingPrice.amount"
    },
    "static_params": {
      "affid": "{{associate_tag}}"
    },
    "headers": {
      "Fk-Affiliate-Token": "{{api_secret}}"
    },
    "affiliate_link_mode": "template",
    "affiliate_link_template": "https://www.flipkart.com{{product_url}}?affid={{associate_tag}}",
    "required_fields": ["api_key", "api_secret", "associate_tag"],
    "field_labels": {
      "api_key": "Affiliate Tracking ID",
      "api_secret": "Affiliate API Token",
      "associate_tag": "Affiliate Tracking ID (same as API Key)"
    }
  },
  "ebay": {
    "base_url": "https://api.ebay.com/buy/browse/v1/item_summary/search",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_prefix": "Bearer ",
    "search_param": "q",
    "response_path": "itemSummaries",
    "field_mapping": {
      "product_id": "itemId",
      "name": "title",
      "price": "price.value",
      "currency": "price.currency",
      "image_url": "image.imageUrl",
      "product_url": "itemAffiliateWebUrl",
      "original_price": "price.value"
    },
    "static_params": {
      "limit": "5"
    },
    "required_fields": ["api_key", "api_secret", "associate_tag"],
    "field_labels": {
      "api_key": "App ID (Client ID)",
      "api_secret": "Cert ID (Client Secret)",
      "associate_tag": "RuName (Redirect URL Name)"
    }
  },
  "alibaba": {
    "base_url": "https://api.alibaba.com/openapi/param2/1/com.alibaba.product/search",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_prefix": "Bearer ",
    "search_param": "keyword",
    "response_path": "data.products",
    "field_mapping": {
      "product_id": "productId",
      "name": "title",
      "price": "price.amount",
      "currency": "price.currency",
      "image_url": "images.0.url",
      "product_url": "productUrl",
      "original_price": "price.amount"
    },
    "static_params": {
      "language": "en",
      "pageSize": "5"
    },
    "required_fields": ["api_key", "api_secret"],
    "field_labels": {
      "api_key": "App Key (AppKey)",
      "api_secret": "App Secret (AppSecret)",
      "associate_tag": "Not Required"
    }
  },
  "walmart": {
    "base_url": "https://api.walmart.com/v3/search",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_prefix": "Bearer ",
    "search_param": "query",
    "response_path": "items",
    "field_mapping": {
      "product_id": "itemId",
      "name": "name",
      "price": "price",
      "currency": "currency",
      "image_url": "imageUrl",
      "product_url": "productUrl",
      "original_price": "price"
    },
    "static_params": {
      "limit": "5"
    },
    "required_fields": ["api_key"],
    "field_labels": {
      "api_key": "API Key",
      "api_secret": "Not Required",
      "associate_tag": "Not Required"
    }
  },
  "daraz": {
    "base_url": "https://parse.bot/api/daraz/pk/products/search",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_prefix": "Bearer ",
    "search_param": "query",
    "response_path": "products",
    "field_mapping": {
      "product_id": "id",
      "name": "name",
      "price": "price_show",
      "currency": "currency",
      "description": "description",
      "image_url": "image_url",
      "affiliate_link": "affiliate_link",
      "product_url": "product_url"
    },
    "static_params": {
      "sort": "price_asc",
      "limit": "5"
    },
    "required_fields": ["api_key"],
    "field_labels": {
      "api_key": "Parse.bot API Key",
      "api_secret": "Not Required",
      "associate_tag": "Not Required"
    }
  },
  "admitad": {
    "base_url": "https://api.admitad.com/search/products",
    "method": "GET",
    "auth_type": "header",
    "auth_header": "Authorization",
    "auth_prefix": "Bearer ",
    "search_param": "q",
    "response_path": "results",
    "field_mapping": {
      "product_id": "id",
      "name": "name",
      "price": "price",
      "currency": "currency",
      "image_url": "image_url",
      "affiliate_link": "promo_link",
      "product_url": "product_url",
      "original_price": "price"
    },
    "static_params": {
      "limit": "5"
    },
    "required_fields": ["api_key", "associate_tag"],
    "field_labels": {
      "api_key": "Admitad API Key",
      "api_secret": "Not Required",
      "associate_tag": "Campaign ID"
    }
  }
}